<?xml version="1.0" encoding="utf-8"?>
<!-- App-style icon of the "Fire TV Home" tile: shown on the same dark card as other icon-only apps -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="96dp" android:height="96dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="315" android:startColor="#FF3B82C9" android:endColor="#FF15365E" />
        </shape>
    </item>
    <item android:width="56dp" android:height="56dp" android:gravity="center" android:drawable="@drawable/ic_home" />
</layer-list>
