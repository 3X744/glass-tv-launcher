<?xml version="1.0" encoding="utf-8"?>
<!-- Recovery tile icon: a list of apps on a dark glass card. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="96dp" android:height="96dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="315" android:startColor="#FF526A82" android:endColor="#FF202A38" />
        </shape>
    </item>
    <item android:width="64dp" android:height="64dp" android:gravity="center" android:drawable="@drawable/ic_hidden_list" />
</layer-list>
