<?xml version="1.0" encoding="utf-8"?>
<!-- Fire TV "Your Apps" banner of the Koi Pond entry (the screensaver as an app) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315" android:startColor="#FF3E9E86" android:endColor="#FF0F3D36" />
        </shape>
    </item>
    <item android:width="150dp" android:height="150dp" android:gravity="center" android:drawable="@drawable/ic_koi" />
</layer-list>
